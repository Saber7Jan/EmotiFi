<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/resultTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="Select an expression to test"
        android:gravity="center"
        android:padding="8dp"/>

    <Button
        android:id="@+id/btnViewLiveSpectrogram"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Live Spectrogram"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/timerTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="#FF5722"
        android:gravity="center"
        android:padding="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnFear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fear"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/btnHappy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Happy"
            android:layout_margin="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNeutral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Neutral"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/btnSad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sad"
            android:layout_margin="4dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnSurprised"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Surprised"
        android:layout_margin="4dp"/>

    <ImageView
        android:id="@+id/spectrogramImageView"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="Spectrogram preview"
        android:visibility="gone" />

    <TextView
        android:id="@+id/csiDataTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:text="Waiting for CSI data..."
        android:padding="8dp"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Instructions:"
        android:textSize="18sp"
        android:paddingTop="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Select an expression to test\n2. Perform that expression for 5 seconds\n3. View detection results"
        android:textSize="14sp"
        android:padding="8dp"/>

</LinearLayout>